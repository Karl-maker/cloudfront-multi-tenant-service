{
  "name": "syncpoly-cloudfront-folder-router",
  "version": "1.0.0",
  "private": true,
  "description": "CloudFront Function that maps domains to S3 client folders.",
  "main": "cloudfront/domain-folder-router.js",
  "bin": {
    "syncpoly-site": "bin/syncpoly-site.js"
  },
  "scripts": {
    "build": "node --check cloudfront/domain-folder-router.js && node --check lib/site-config-schema.js && node --check lib/site-upload.js && node --check lib/godaddy-dns.js && node --check bin/syncpoly-site.js && node --check test/cloudfront-function.test.js && node --check test/site-upload.test.js",
    "clawbot:start": "./bin/start-clawbot.sh",
    "clawbot:check": "docker compose config --quiet",
    "clawbot:openclaw": "./bin/openclaw-clawbot.sh",
    "deploy:global-404": "./bin/upload-global-404.sh",
    "site": "node bin/syncpoly-site.js",
    "site:upload-config": "node bin/syncpoly-site.js upload-config",
    "site:upload-folder": "node bin/syncpoly-site.js upload-folder",
    "site:upload-template": "node bin/syncpoly-site.js upload-template",
    "site:upload-media": "node bin/syncpoly-site.js upload-media",
    "site:upload-seo": "node bin/syncpoly-site.js upload-seo",
    "site:validate-config": "node bin/syncpoly-site.js validate-config",
    "site:make": "node bin/syncpoly-site.js make-site",
    "site:make-input": "node bin/syncpoly-site.js make-input",
    "site:make-config": "node bin/syncpoly-site.js make-siteconfig",
    "site:make-seo": "node bin/syncpoly-site.js make-seo",
    "site:media-manifest": "node bin/syncpoly-site.js media-manifest",
    "site:audit": "node bin/syncpoly-site.js audit-site",
    "site:add-route": "node bin/syncpoly-site.js add-route",
    "site:launch-check": "node bin/syncpoly-site.js launch-check",
    "site:make-outreach": "node bin/syncpoly-site.js make-outreach",
    "site:screenshot": "node bin/syncpoly-site.js screenshot",
    "site:screenshot-audit": "node bin/syncpoly-site.js screenshot-audit",
    "site:publish": "node bin/syncpoly-site.js publish",
    "godaddy:add-cname": "node bin/syncpoly-site.js add-cname",
    "test": "node --test test/cloudfront-function.test.js test/site-upload.test.js",
    "test:unit": "npm test",
    "terraform:fmt": "terraform -chdir=infra fmt -check",
    "terraform:validate": "terraform -chdir=infra init -backend=false && terraform -chdir=infra validate"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  }
}
