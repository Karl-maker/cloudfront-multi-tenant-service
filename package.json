{
  "name": "syncpoly-cloudfront-folder-router",
  "version": "1.0.0",
  "private": true,
  "description": "CloudFront Function that maps domains to S3 client folders.",
  "main": "cloudfront/domain-folder-router.js",
  "scripts": {
    "build": "node --check cloudfront/domain-folder-router.js && node --check test/cloudfront-function.test.js",
    "deploy:global-404": "./bin/upload-global-404.sh",
    "test": "node --test test/cloudfront-function.test.js",
    "test:unit": "npm test",
    "terraform:fmt": "terraform -chdir=infra fmt -check",
    "terraform:validate": "terraform -chdir=infra init -backend=false && terraform -chdir=infra validate"
  },
  "engines": {
    "node": ">=20"
  }
}
