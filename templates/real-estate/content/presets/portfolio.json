{
  "$schema": "../site.schema.json",
  "deployment": { "basePath": "", "assetPrefix": "" },
  "site": {
    "name": "Riley Portfolio",
    "shortName": "Riley",
    "url": "https://example.com",
    "locale": "en_US",
    "description": "A portfolio preset for independent consultants, designers, engineers, and studios.",
    "updatedAt": "2026-05-28",
    "keywords": ["portfolio", "case studies", "consultant"],
    "author": { "name": "Riley Portfolio", "url": "https://example.com" },
    "manifest": {
      "display": "standalone",
      "orientation": "portrait",
      "backgroundColor": "#f4f7f8",
      "themeColor": "#263f52",
      "icon": "/images/icon.svg",
      "categories": ["business", "productivity"]
    },
    "pwa": { "enabled": true, "serviceWorker": "/sw.js", "offlinePath": "/offline/", "cacheName": "riley-portfolio-v1" },
    "llms": { "summary": "Portfolio page map for AI assistants.", "notes": ["Replace project details with accurate public case studies."] }
  },
  "seo": {
    "titleTemplate": "%s | Riley Portfolio",
    "defaultTitle": "Riley Portfolio",
    "defaultImage": "/images/og-default.svg",
    "robots": { "index": true, "follow": true, "allow": ["/"], "disallow": [] },
    "structuredData": {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Riley Portfolio",
      "url": "https://example.com"
    }
  },
  "theme": {
    "mode": "light",
    "colors": {
      "background": "#f4f7f8",
      "surface": "#ffffff",
      "surfaceAlt": "#e8eef2",
      "text": "#17242d",
      "muted": "#60707a",
      "primary": "#263f52",
      "primaryContrast": "#ffffff",
      "accent": "#d9895b",
      "accentContrast": "#1c1713",
      "border": "#d7e0e5"
    },
    "fonts": { "heading": "Inter, ui-sans-serif, system-ui, sans-serif", "body": "Inter, ui-sans-serif, system-ui, sans-serif" },
    "radius": "8px",
    "maxWidth": "1080px",
    "background": { "type": "solid", "value": "#f4f7f8" },
    "customCss": ""
  },
  "navigation": {
    "logoText": "Riley",
    "links": [
      { "label": "Work", "href": "/#work" },
      { "label": "About", "href": "/#about" },
      { "label": "Contact", "href": "/#contact" }
    ],
    "cta": { "label": "Start a Project", "href": "/#contact", "style": "primary" }
  },
  "blocks": {
    "defaultContact": {
      "id": "contact",
      "type": "contact",
      "title": "Start a project",
      "body": "Replace these routes with your public inquiry channels.",
      "methods": [
        { "label": "Email", "value": "hello@example.com", "href": "mailto:hello@example.com" },
        { "label": "LinkedIn", "value": "Connect professionally", "href": "https://www.linkedin.com" }
      ],
      "form": { "enabled": false }
    },
    "defaultFaq": {
      "id": "faq",
      "type": "faq",
      "kicker": "FAQ",
      "title": "Working together",
      "items": [
        { "question": "What projects are a fit?", "answer": "Replace with your qualification criteria." },
        { "question": "How do engagements start?", "answer": "Replace with your discovery process." }
      ]
    }
  },
  "pages": [
    {
      "path": "/",
      "title": "Home",
      "layout": "landing",
      "description": "Portfolio landing page preset.",
      "seo": { "title": "Selected Work and Services", "description": "A portfolio landing page with work, about, FAQ, and contact sections.", "image": "/images/og-default.svg" },
      "sections": [
        { "id": "hero", "type": "hero", "variant": "centered", "kicker": "Portfolio preset", "title": "Selected work for teams that need sharper systems.", "body": "Use this single-page structure for consultants, designers, developers, and small studios." },
        {
          "id": "work",
          "type": "cardGrid",
          "kicker": "Work",
          "title": "Case studies",
          "columns": 3,
          "items": [
            { "title": "Project Alpha", "body": "Replace with the problem, role, and result." },
            { "title": "Project Beta", "body": "Replace with a concise case-study summary." },
            { "title": "Project Gamma", "body": "Replace with a verified measurable outcome." }
          ]
        },
        { "id": "about", "type": "richText", "kicker": "About", "title": "A short positioning section", "content": ["Explain who you help, what you make, and the standards you bring to the work.", "Keep this section specific enough that the right buyer can self-select."] },
        { "use": "defaultFaq" },
        { "use": "defaultContact" }
      ]
    },
    {
      "path": "/offline/",
      "title": "Offline",
      "layout": "content",
      "description": "Offline fallback page.",
      "sections": [
        { "id": "offline-message", "type": "hero", "variant": "centered", "kicker": "Offline", "title": "You are offline.", "body": "Reconnect to view the portfolio." }
      ]
    }
  ],
  "footer": {
    "tagline": "Portfolio static site preset.",
    "links": [
      { "label": "Sitemap", "href": "/sitemap.xml" },
      { "label": "LLMs", "href": "/llms.txt" }
    ],
    "copyright": "(c) 2026 Riley Portfolio."
  }
}

