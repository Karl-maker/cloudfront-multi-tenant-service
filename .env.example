# OpenClaw reads this file through Docker Compose interpolation on the host.
# It is not mounted into the OpenClaw workspace.

# Set one or both. The start script mirrors either value to the missing alias.
OPEN_AI_KEY=
OPENAI_API_KEY=

OPENCLAW_PORT=18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_MODEL_OPENAI=openai/gpt-5.4-mini
OPENCLAW_CONTEXT_TOKENS=131072
OPENCLAW_AGENT_TIMEOUT_SECONDS=300
OPENCLAW_COMPACTION_RESERVE_TOKENS=24576
OPENCLAW_COMPACTION_MODEL=openai/gpt-5.4-mini
OPENCLAW_HEARTBEAT_TIMEOUT_SECONDS=300
OPENCLAW_HEARTBEAT_MODEL=openai/gpt-5.4-nano
OPENCLAW_WHATSAPP_PENDING_MAX_AGE_SECONDS=300

CONTENT_BUCKET=syncpoly-web-builder-sites
CLOUDFRONT_DOMAIN_NAME=

AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_SHARED_CREDENTIALS_FILE=/home/node/.aws/credentials
AWS_CONFIG_FILE=/home/node/.aws/config
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

GODADDY_API_KEY=
GODADDY_API_SECRET=
